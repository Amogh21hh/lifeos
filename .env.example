# ─── LIFEOS configuration ────────────────────────────────────────────────
# Copy to .env.local. Every variable is optional: with none set, LIFEOS runs on an embedded
# Postgres (PGlite + pgvector), the local reasoning engine and local embeddings.

# Database. Leave unset for embedded PGlite persisted in ./.data/pglite.
# DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos
# DATABASE_POOL_SIZE=10
# PGLITE_DIR=./.data/pglite          # or ":memory:" for throwaway runs

# Seed the demo workspace on first boot when the database is empty (default: true)
# LIFEOS_AUTO_SEED=true
# LIFEOS_ALLOW_SIGNUP=true

# ─── AI provider (server-side only; never exposed to the browser) ─────────
# Anthropic (official SDK, structured outputs)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high
# ANTHROPIC_FALLBACKS=true           # server-side refusal fallbacks (beta)

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure, Ollama, LM Studio, vLLM…)
# AI_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama3.1

# Embeddings: default is the local feature-hashing embedder (no network).
# EMBEDDINGS_PROVIDER=openai_compatible
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small   # requested at 256 dimensions; re-seed/reindex after switching

# ─── Files ───────────────────────────────────────────────────────────────
# STORAGE_DRIVER=disk                # disk (default) | database — use "database" on Vercel/serverless
# STORAGE_DIR=./.data/uploads        # used by the disk driver only
# MAX_UPLOAD_MB=10                   # keep at 4 on Vercel (4.5 MB request body limit)

# ─── Observability ───────────────────────────────────────────────────────
# LOG_LEVEL=info                     # debug | info | warn | error

# ─── Vercel / serverless (set these in the Vercel project, never in git) ──
# DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require   # Neon pooled connection string
# DATABASE_POOL_SIZE=5
# STORAGE_DRIVER=database
# MAX_UPLOAD_MB=4
